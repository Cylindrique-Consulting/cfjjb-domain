    "./belts": "./src/belts.ts",
    "./referential": "./src/referential.ts",
    "./prng": "./src/prng.ts",
    "./seeding-plan": "./src/seeding-plan.ts",
    "./bracket-generator": "./src/bracket-generator.ts",
    "./competition-format": "./src/competition-format.ts",
    "./pool-generator": "./src/pool-generator.ts",
    "./pool-ranking": "./src/pool-ranking.ts",
    "./category-draw": "./src/category-draw.ts",
    "./absolut-seeding": "./src/absolut-seeding.ts",
    "./squad-composition": "./src/squad-composition.ts",
    "./separation-equipe": "./src/separation-equipe.ts",
    "./planning-generator": "./src/planning-generator.ts",
    "./medals": "./src/medals.ts",
    "./capacity": "./src/capacity.ts",
    "./sizing": "./src/sizing.ts",
    "./bracket-propagation": "./src/bracket-propagation.ts",
    "./control-state": "./src/control-state.ts",
    "./capabilities": "./src/capabilities.ts",
    "./medido": "./src/medido.ts",
