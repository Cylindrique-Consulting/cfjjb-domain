{
  "name": "@cfjjb/domain",
  "version": "0.2.0",
  "description": "Noyau métier CFJJB : référentiel poids/durées/ceintures, générateur de brackets, planning, médailles. TypeScript pur, sans IO.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums.ts",
    "./belts": "./src/belts.ts",
    "./referential": "./src/referential.ts",
    "./bracket-generator": "./src/bracket-generator.ts",
    "./planning-generator": "./src/planning-generator.ts",
    "./medals": "./src/medals.ts",
    "./bracket-propagation": "./src/bracket-propagation.ts",
    "./control-state": "./src/control-state.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.5"
  }
}
